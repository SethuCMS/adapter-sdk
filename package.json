{
  "name": "@sethucms/adapter-sdk",
  "version": "0.1.0",
  "description": "Adapter contract, guard layer and conformance suite for SethuCMS",
  "author": "Kasinadh Sarma",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SethuCMS/sethucms-adapter-sdk.git"
  },
  "homepage": "https://github.com/SethuCMS/sethucms-adapter-sdk#readme",
  "bugs": {
    "url": "https://github.com/SethuCMS/sethucms-adapter-sdk/issues"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    },
    "./grpc": {
      "types": "./dist/src/grpc/index.d.ts",
      "default": "./dist/src/grpc/index.js"
    }
  },
  "files": [
    "dist/src",
    "proto"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/tests/*.test.js",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@sethucms/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@sethucms/core": "link:../sethucms/packages/core"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
